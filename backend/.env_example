# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=sensores/+/datos

# Base de datos
# SQLite para desarrollo local
DATABASE_URL=sqlite:///./monitoreo.db

# Ejemplo para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/monitoreo

# Telegram
# Crear el bot mediante @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# CORS
# Permitir todos los orígenes durante el desarrollo
CORS_ORIGINS=["*"]

# Ejemplo para producción:
# CORS_ORIGINS=["https://tu-dominio.com"]

# JWT
# En producción usar un secreto generado con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Controles de demostración
# Permitir activar/desactivar sensores sin permisos de escritura reales
